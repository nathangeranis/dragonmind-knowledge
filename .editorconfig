root = true

# ===========================================================================
# Globalization analyzers — the standing guard against culture-sensitive
# identifier folding.
#
# This codebase folds identifiers (domain identifiers, type names, and
# externally-supplied JSON property names) and then compares the result
# against ASCII literals. Turkish and Azeri fold uppercase 'I' to the
# dotless 'ı' and lowercase 'i' to the dotted 'İ', so on such a host the
# comparison stops matching and the value is dropped — silently, because
# every one of those lookups has a default arm that is a legitimate value
# for something else. There is no culture configuration anywhere in the
# solution, so the culture is whatever the host OS says it is.
#
# Severities live here rather than in MSBuild because these rules ship
# disabled by default, and an .editorconfig severity is what turns them on for
# both the build and the IDE. (EnableNETAnalyzers is already the SDK default
# for net10.0, so no Directory.Build.props is needed.)
#
# Measured against the whole solution at the time of writing:
#
#   CA1304  Specify CultureInfo                          0 violations  -> error
#   CA1311  Specify a culture or use an invariant version 0 violations  -> error
#   CA1310  StringComparison for correctness             34 violations  -> warning
#   CA1305  Specify IFormatProvider                     326 violations  -> off
#   CA1307  StringComparison for clarity                958 violations  -> off
#
# CA1304 and CA1311 are the two that cover ToUpper/ToLower directly. They are
# at zero and are errors, so a new culture-sensitive fold in a .cs file cannot
# reach main without someone explicitly suppressing the rule.
#
# CA1310 is a correctness rule and its 34 hits are all genuine candidates —
# StartsWith/EndsWith calls that should almost certainly be ordinal. They are
# warnings rather than errors because each needs its own judgement about
# whether ordinal changes behaviour, which is a separate piece of work from
# the identifier folding this file exists for.
#
# CA1305 and CA1307 are deliberately NOT enabled. They are about number/date
# formatting and about spelling comparisons out explicitly, not about
# identifier folding, and at 326 and 958 hits they would bury the two rules
# that matter. Turning them on is a standalone decision, not a side effect.
# ===========================================================================
[*.cs]
dotnet_diagnostic.CA1304.severity = error
dotnet_diagnostic.CA1311.severity = error
dotnet_diagnostic.CA1310.severity = warning

# ===========================================================================
# IDE0390 / IDE0391 - the replacement for the deleted CS1998.
#
# CS1998 ("This async method lacks 'await' operators and will run
# synchronously") is gone. Not suppressed, not downgraded to none - deleted
# from the compiler in dotnet/roslyn#80144, after dotnet/roslyn#77001 decided
# it was doing more harm than good: the usual "fix" was a meaningless
# `await Task.FromResult(...)`, which buys a state machine and hides nothing.
# Verified locally on an identical probe file: SDK 9.0.120 emits it, SDK
# 10.0.400 emits nothing, for every shape (async Task, async Task<T>, async
# void, expression-bodied, empty body). TFM and LangVersion are irrelevant;
# the SDK is what changed, and CI pins 10.0.x, so CI lost it too.
#
# Roslyn shipped the detection back as an opt-in IDE analyzer
# (dotnet/roslyn#81835), split in two:
#
#   IDE0390  ordinary methods and lambdas
#   IDE0391  interface implementations and overrides
#
# The split exists because the second group is the contentious one - the
# signature is forced by a contract, so an await-free body can be entirely
# correct and the only available fix is to drop `async` and return
# Task.CompletedTask. Both are at zero violations as of this change and both
# are errors, matching CA1304/CA1311 above: a new await-free async method
# cannot reach main without someone explicitly suppressing the rule.
#
# These are IDE-layer rules, so a severity here is only half of what they
# need - <EnforceCodeStyleInBuild> in Directory.Build.props is the other half.
# With the property but no severity they emit nothing at build time, even
# under AnalysisMode=All. With the severity but no property they are
# editor-only. Removing either silently disables the guard.
# ===========================================================================
dotnet_diagnostic.IDE0390.severity = error
dotnet_diagnostic.IDE0391.severity = error

# ===========================================================================
# xUnit1051 - deliberately suppressed for test code only.
#
# xunit.v3 3.2.2 ships an analyzer that flags every call to a method
# accepting CancellationToken where the call site does not pass
# TestContext.Current.CancellationToken explicitly. It is a responsiveness
# suggestion, not a correctness rule: TestContext.Current.CancellationToken
# only ever fires on an external test-run cancellation (e.g. a CI timeout
# killing the run), and every flagged call in this solution already passes
# or defaults safely without one.
#
# A clean rebuild with `dotnet build -c Release -warnaserror` measured 133
# violations across 15 files in tests/Dragonmind.Knowledge.UnitTests and
# tests/Dragonmind.Knowledge.IntegrationTests - ordinary calls like
# `await facade.SearchKnowledgeAsync(query, scopeId: null)` or
# `_sut.GetRelatedFactsAsync(entityName, scopeId)`. Threading
# TestContext.Current.CancellationToken through all 133 call sites would
# touch nearly every test method in both projects for a rule that changes
# no behaviour today and would need re-litigating at every new test added
# afterward, for a benefit (faster external test-run cancellation) this
# suite has no evidence of needing. That is a materially different
# trade-off from CA1304/CA1311/IDE0390/IDE0391 above, which are all at zero
# violations and guard against a real, previously-seen defect class
# (culture-sensitive identifier folding, silently-lost async diagnostics).
# There is no equivalent defect history behind xUnit1051 here.
#
# Scoped to tests/ only - this analyzer ships with xunit.v3 and cannot fire
# outside a test project, but the explicit path keeps the suppression
# visible as a test-only decision rather than a blanket one.
# ===========================================================================
[tests/**/*.cs]
dotnet_diagnostic.xUnit1051.severity = none
